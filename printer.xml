<mujoco model="CoreXY_FDM_Printer">
  <!--
    CoreXY FDM 3D Printer — MuJoCo MJCF Model
    ============================================
    Modeled after high-speed CoreXY systems (Bambu Lab X1E class).

    Build volume : 256 × 256 × 256 mm  (0.256 × 0.256 × 0.256 m)
    Coordinate convention:
      X  = left-right carriage travel (CoreXY)
      Y  = front-back gantry beam travel (CoreXY)
      Z  = bed elevation (lead-screw, moves DOWN from home)
    Origin is at the centre of the base frame bottom.
  -->

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--  COMPILER / OPTIONS / DEFAULTS                                      -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <compiler angle="radian" coordinate="local" inertiafromgeom="auto"/>

  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicit">
    <flag contact="enable" gravity="enable"/>
  </option>

  <default>
    <!-- Global contact / friction defaults -->
    <geom condim="3" friction="0.8 0.005 0.001" solref="0.002 1.0"
          solimp="0.9 0.95 0.001" margin="0.0005"/>
    <joint damping="2.0" armature="0.01"/>
    <!-- Default actuator gains (overridden per-actuator below) -->
    <general ctrllimited="true" forcelimited="true"/>
  </default>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--  ASSETS — materials & meshes                                        -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <asset>
    <!-- Frame / structural aluminium -->
    <material name="mat_frame"    rgba="0.25 0.25 0.28 1"  shininess="0.3" specular="0.4"/>
    <!-- Anodised black motion components -->
    <material name="mat_rail"     rgba="0.12 0.12 0.14 1"  shininess="0.6" specular="0.5"/>
    <!-- Heated bed — dark glass / PEI surface -->
    <material name="mat_bed"      rgba="0.15 0.15 0.17 1"  shininess="0.8" specular="0.7"/>
    <!-- Toolhead / extruder housing -->
    <material name="mat_toolhead" rgba="0.35 0.35 0.38 1"  shininess="0.4" specular="0.3"/>
    <!-- Copper nozzle -->
    <material name="mat_nozzle"   rgba="0.72 0.45 0.20 1"  shininess="0.9" specular="0.8"/>
    <!-- Deposited filament (PLA-like) -->
    <material name="mat_filament" rgba="0.1 0.6 0.95 1"    shininess="0.3" specular="0.2"/>
    <!-- Build-volume bounding wireframe (transparent) -->
    <material name="mat_volume"   rgba="0.3 0.7 1.0 0.08"  shininess="0.0" specular="0.0"/>
    <!-- LED accent strip -->
    <material name="mat_led"      rgba="0.95 0.95 1.0 0.6" emission="0.8"/>
    <!-- Filament spool — vibrant red PLA -->
    <material name="mat_spool"    rgba="0.9 0.1 0.1 1"     shininess="0.5" specular="0.4"/>
    <!-- Spool holder bracket — dark metal -->
    <material name="mat_spool_bracket" rgba="0.18 0.18 0.20 1" shininess="0.4" specular="0.3"/>
    <!-- Printed object — matching red -->
    <material name="mat_print_obj" rgba="0.88 0.12 0.12 1" shininess="0.35" specular="0.25"/>
    <!-- Filament strand (thin red) -->
    <material name="mat_strand"   rgba="0.9 0.1 0.1 0.85" shininess="0.3" specular="0.2"/>
  </asset>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--  WORLDBODY                                                          -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <worldbody>
    <!-- Ground plane -->
    <geom name="ground" type="plane" size="0.6 0.6 0.01"
          rgba="0.18 0.18 0.20 1" pos="0 0 0" contype="1" conaffinity="1"/>

    <!-- Ambient / key lights -->
    <light name="key_light"   pos="0.5 -0.5 1.2" dir="-0.4 0.4 -0.8"
           diffuse="0.9 0.9 0.95" specular="0.5 0.5 0.5" castshadow="true"/>
    <light name="fill_light"  pos="-0.4 0.3 0.9" dir="0.3 -0.2 -0.7"
           diffuse="0.4 0.4 0.45" specular="0.1 0.1 0.1"/>
    <!-- Rim light for spool highlight -->
    <light name="rim_light"   pos="0.3 0.4 0.8" dir="-0.3 -0.3 -0.6"
           diffuse="0.25 0.25 0.3" specular="0.2 0.2 0.2"/>

    <!-- ─────────────────────────────────────────────────────────────── -->
    <!--  PRINTER BASE FRAME                                             -->
    <!-- ─────────────────────────────────────────────────────────────── -->
    <body name="base_frame" pos="0 0 0.005">
      <!-- Bottom plate -->
      <geom name="base_plate" type="box" size="0.18 0.18 0.005"
            pos="0 0 0" mass="3.0" material="mat_frame"
            contype="1" conaffinity="1"/>

      <!-- Four vertical corner extrusions (2020 aluminium profile analogue) -->
      <geom name="pillar_FL" type="box" size="0.012 0.012 0.195"
            pos="-0.16 -0.16 0.2"  mass="0.25" material="mat_frame"/>
      <geom name="pillar_FR" type="box" size="0.012 0.012 0.195"
            pos=" 0.16 -0.16 0.2"  mass="0.25" material="mat_frame"/>
      <geom name="pillar_BL" type="box" size="0.012 0.012 0.195"
            pos="-0.16  0.16 0.2"  mass="0.25" material="mat_frame"/>
      <geom name="pillar_BR" type="box" size="0.012 0.012 0.195"
            pos=" 0.16  0.16 0.2"  mass="0.25" material="mat_frame"/>

      <!-- Top cross-beams (connect pillars) -->
      <geom name="top_beam_front" type="box" size="0.148 0.010 0.010"
            pos="0 -0.16 0.39" mass="0.2" material="mat_frame"/>
      <geom name="top_beam_back"  type="box" size="0.148 0.010 0.010"
            pos="0  0.16 0.39" mass="0.2" material="mat_frame"/>
      <geom name="top_beam_left"  type="box" size="0.010 0.148 0.010"
            pos="-0.16 0 0.39" mass="0.2" material="mat_frame"/>
      <geom name="top_beam_right" type="box" size="0.010 0.148 0.010"
            pos=" 0.16 0 0.39" mass="0.2" material="mat_frame"/>

      <!-- LED accent strip (front) -->
      <geom name="led_strip" type="box" size="0.14 0.002 0.003"
            pos="0 -0.162 0.37" material="mat_led" contype="0" conaffinity="0"/>

      <!-- Build-volume bounding box (visual only) -->
      <geom name="build_volume" type="box" size="0.128 0.128 0.128"
            pos="0 0 0.138" material="mat_volume"
            contype="0" conaffinity="0" group="1"/>

      <!-- ─────────────────────────────────────────────────────────── -->
      <!--  FILAMENT SPOOL & HOLDER (top-right of frame)               -->
      <!-- ─────────────────────────────────────────────────────────── -->
      <!-- Spool holder L-bracket (bolted to back-right pillar top) -->
      <geom name="spool_bracket_vert" type="box" size="0.008 0.008 0.04"
            pos="0.16 0.12 0.44" material="mat_spool_bracket"
            contype="0" conaffinity="0"/>
      <geom name="spool_bracket_horiz" type="box" size="0.04 0.008 0.005"
            pos="0.16 0.12 0.485" material="mat_spool_bracket"
            contype="0" conaffinity="0"/>
      <!-- Spool axle (horizontal rod) -->
      <geom name="spool_axle" type="cylinder" size="0.004 0.025"
            pos="0.16 0.12 0.52" euler="1.5708 0 0"
            material="mat_rail" contype="0" conaffinity="0"/>
      <!-- Filament spool — main barrel -->
      <geom name="spool_barrel" type="cylinder" size="0.035 0.018"
            pos="0.16 0.12 0.52" euler="1.5708 0 0"
            material="mat_spool" contype="0" conaffinity="0"/>
      <!-- Spool flanges (left & right discs) -->
      <geom name="spool_flange_L" type="cylinder" size="0.048 0.002"
            pos="0.16 0.098 0.52" euler="1.5708 0 0"
            material="mat_spool" contype="0" conaffinity="0"/>
      <geom name="spool_flange_R" type="cylinder" size="0.048 0.002"
            pos="0.16 0.142 0.52" euler="1.5708 0 0"
            material="mat_spool" contype="0" conaffinity="0"/>
      <!-- Spool hub (inner hole visual) -->
      <geom name="spool_hub" type="cylinder" size="0.015 0.020"
            pos="0.16 0.12 0.52" euler="1.5708 0 0"
            rgba="0.6 0.08 0.08 1"
            contype="0" conaffinity="0"/>
      <!-- Site at spool filament exit point (for dynamic strand) -->
      <site name="spool_exit_site" pos="0.16 0.10 0.48"
            size="0.003" rgba="0.9 0.1 0.1 0.6" group="3"/>

      <!-- Static filament guide tube (spool → frame top → near gantry) -->
      <!-- Segment 1: spool exit down to frame top -->
      <geom name="fil_guide_1" type="capsule" size="0.0015"
            fromto="0.16 0.10 0.48  0.12 0.04 0.42"
            material="mat_strand" contype="0" conaffinity="0"/>
      <!-- Segment 2: across frame top toward centre -->
      <geom name="fil_guide_2" type="capsule" size="0.0015"
            fromto="0.12 0.04 0.42  0.04 0.0 0.40"
            material="mat_strand" contype="0" conaffinity="0"/>

      <!-- ─────────────────────────────────────────────────────────── -->
      <!--  Z-AXIS: HEATED BED ON LEAD-SCREW SLIDE                    -->
      <!-- ─────────────────────────────────────────────────────────── -->
      <!-- Z linear rail visuals (left/right of bed) -->
      <geom name="z_rail_L" type="box" size="0.006 0.006 0.14"
            pos="-0.14 0 0.16" material="mat_rail" contype="0" conaffinity="0"/>
      <geom name="z_rail_R" type="box" size="0.006 0.006 0.14"
            pos=" 0.14 0 0.16" material="mat_rail" contype="0" conaffinity="0"/>

      <body name="bed_carriage" pos="0 0 0.26">
        <joint name="joint_z" type="slide" axis="0 0 1"
               range="-0.246 0.0" damping="8.0" armature="0.05"
               ref="0"/>
        <inertial pos="0 0 0" mass="1.2"
                  diaginertia="0.005 0.005 0.002"/>

        <!-- Bed support brackets -->
        <geom name="bed_bracket_L" type="box" size="0.008 0.06 0.008"
              pos="-0.13 0 0" material="mat_rail" contype="0" conaffinity="0"/>
        <geom name="bed_bracket_R" type="box" size="0.008 0.06 0.008"
              pos=" 0.13 0 0" material="mat_rail" contype="0" conaffinity="0"/>

        <!-- Heated print bed surface (256 × 256 mm, 4 mm thick) -->
        <geom name="print_bed" type="box" size="0.128 0.128 0.002"
              pos="0 0 0.002" mass="0.8" material="mat_bed"
              contype="1" conaffinity="1"
              friction="1.0 0.005 0.001"
              solref="0.001 1.2" solimp="0.95 0.99 0.001"/>
        <!-- Bed heater PCB (visual) -->
        <geom name="bed_heater" type="box" size="0.12 0.12 0.001"
              pos="0 0 -0.003" rgba="0.3 0.08 0.08 0.7"
              contype="0" conaffinity="0"/>

        <!-- Nozzle contact detection site (on bed surface) -->
        <site name="bed_surface_centre" pos="0 0 0.004" size="0.002"
              rgba="1 0 0 0" group="3"/>

        <!-- ─────────────────────────────────────────────── -->
        <!--  PRINTED OBJECT: 5 cm test cube on bed          -->
        <!-- ─────────────────────────────────────────────── -->
        <!--  Pre-allocated layers for dynamic growth (1cm each) -->
        <!-- Layer 1 (0 to 1 cm) -->
        <geom name="print_layer_1" type="box" size="0.025 0.025 0.005"
              pos="0 0 0.009" material="mat_print_obj" rgba="0.88 0.12 0.12 0"
              contype="0" conaffinity="0"/>
        <!-- Layer 2 (1 to 2 cm) -->
        <geom name="print_layer_2" type="box" size="0.025 0.025 0.005"
              pos="0 0 0.019" material="mat_print_obj" rgba="0.88 0.12 0.12 0"
              contype="0" conaffinity="0"/>
        <!-- Layer 3 (2 to 3 cm) -->
        <geom name="print_layer_3" type="box" size="0.025 0.025 0.005"
              pos="0 0 0.029" material="mat_print_obj" rgba="0.88 0.12 0.12 0"
              contype="0" conaffinity="0"/>
        <!-- Layer 4 (3 to 4 cm) -->
        <geom name="print_layer_4" type="box" size="0.025 0.025 0.005"
              pos="0 0 0.039" material="mat_print_obj" rgba="0.88 0.12 0.12 0"
              contype="0" conaffinity="0"/>
        <!-- Layer 5 (4 to 5 cm) -->
        <geom name="print_layer_5" type="box" size="0.025 0.025 0.005"
              pos="0 0 0.049" material="mat_print_obj" rgba="0.88 0.12 0.12 0"
              contype="0" conaffinity="0"/>
      </body>

      <!-- ─────────────────────────────────────────────────────────── -->
      <!--  COREXY GANTRY (Y-AXIS BEAM → X-AXIS CARRIAGE)             -->
      <!-- ─────────────────────────────────────────────────────────── -->
      <!-- Y-axis: gantry beam slides front ↔ back along two rails -->
      <body name="y_gantry" pos="0 0 0.36">
        <!-- Y linear rail visuals -->
        <geom name="y_rail_L" type="box" size="0.005 0.135 0.005"
              pos="-0.145 0 0" material="mat_rail" contype="0" conaffinity="0"/>
        <geom name="y_rail_R" type="box" size="0.005 0.135 0.005"
              pos=" 0.145 0 0" material="mat_rail" contype="0" conaffinity="0"/>

        <body name="y_carriage" pos="0 0 0">
          <joint name="joint_y" type="slide" axis="0 1 0"
                 range="-0.128 0.128" damping="3.0" armature="0.02"/>
          <inertial pos="0 0 0" mass="0.35"
                    diaginertia="0.001 0.0005 0.0005"/>

          <!-- Cross-beam (the moving Y beam that carries X carriage) -->
          <geom name="y_beam" type="box" size="0.135 0.010 0.010"
                pos="0 0 0" mass="0.15" material="mat_rail"/>

          <!-- ───────────────────────────────────────────────────── -->
          <!--  X-AXIS CARRIAGE (on the Y beam)                      -->
          <!-- ───────────────────────────────────────────────────── -->
          <!-- X linear rail along Y beam -->
          <geom name="x_rail" type="box" size="0.125 0.004 0.004"
                pos="0 0 -0.012" material="mat_rail"
                contype="0" conaffinity="0"/>

          <body name="x_carriage" pos="0 0 -0.014">
            <joint name="joint_x" type="slide" axis="1 0 0"
                   range="-0.128 0.128" damping="3.0" armature="0.02"/>
            <inertial pos="0 0 0" mass="0.15"
                      diaginertia="0.0003 0.0003 0.0002"/>

            <!-- ─────────────────────────────────────────────── -->
            <!--  TOOLHEAD / EXTRUDER ASSEMBLY                   -->
            <!-- ─────────────────────────────────────────────── -->
            <body name="toolhead" pos="0 0 -0.01">
              <!-- Filament inlet site (top of extruder, for dynamic strand) -->
              <site name="toolhead_inlet_site" pos="0 0 0.022"
                    size="0.002" rgba="0.9 0.1 0.1 0.5" group="3"/>

              <!-- Extruder motor + gears housing -->
              <geom name="extruder_housing" type="box"
                    size="0.018 0.022 0.02" pos="0 0 0"
                    mass="0.12" material="mat_toolhead"/>

              <!-- Filament entry funnel (visual, on top of extruder) -->
              <geom name="filament_funnel" type="cylinder" size="0.005 0.003"
                    pos="0 0 0.023" material="mat_spool_bracket"
                    contype="0" conaffinity="0"/>

              <!-- Heat-sink fins (visual stack) -->
              <geom name="heatsink_1" type="box" size="0.016 0.016 0.001"
                    pos="0 0 -0.024" material="mat_toolhead"
                    contype="0" conaffinity="0"/>
              <geom name="heatsink_2" type="box" size="0.016 0.016 0.001"
                    pos="0 0 -0.028" material="mat_toolhead"
                    contype="0" conaffinity="0"/>
              <geom name="heatsink_3" type="box" size="0.016 0.016 0.001"
                    pos="0 0 -0.032" material="mat_toolhead"
                    contype="0" conaffinity="0"/>

              <!-- Heat-break tube -->
              <geom name="heatbreak" type="cylinder" size="0.003 0.008"
                    pos="0 0 -0.042" material="mat_rail"
                    contype="0" conaffinity="0"/>

              <!-- Heater block -->
              <geom name="heater_block" type="box" size="0.008 0.010 0.006"
                    pos="0 0 -0.056" mass="0.03"
                    rgba="0.55 0.55 0.58 1"/>

              <!-- ─────────────────────────────────────────── -->
              <!--  HOTEND NOZZLE                              -->
              <!-- ─────────────────────────────────────────── -->
              <body name="nozzle_body" pos="0 0 -0.064">
                <!-- Nozzle cone (truncated) -->
                <geom name="nozzle_cone" type="cylinder"
                      size="0.004 0.004" pos="0 0 0"
                      mass="0.008" material="mat_nozzle"
                      contype="0" conaffinity="0"/>
                <!-- Nozzle tip (the contact point for first-layer) -->
                <geom name="nozzle_tip" type="sphere"
                      size="0.002" pos="0 0 -0.005"
                      mass="0.002" material="mat_nozzle"
                      contype="2" conaffinity="1"
                      friction="0.3 0.001 0.0005"
                      solref="0.001 0.8" solimp="0.95 0.99 0.001"/>

                <!-- Nozzle tip tracking site -->
                <site name="nozzle_tip_site" pos="0 0 -0.005"
                      size="0.0015" rgba="1 0.3 0 0.9" group="0"/>
              </body>

              <!-- Part-cooling fan duct (visual) -->
              <geom name="fan_duct" type="box" size="0.014 0.006 0.014"
                    pos="0.020 0 -0.040" rgba="0.3 0.3 0.32 0.7"
                    contype="0" conaffinity="0"/>

            </body> <!-- /toolhead -->
          </body> <!-- /x_carriage -->
        </body> <!-- /y_carriage -->
      </body> <!-- /y_gantry -->

    </body> <!-- /base_frame -->
  </worldbody>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--  ACTUATORS — position servos with PD gains                          -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--
    Gain tuning rationale (high-speed CoreXY):
      X/Y: light carriages → high kp for snappy tracking, moderate kv
      Z:   heavier bed + lead-screw reduction → higher kp, more damping
  -->
  <actuator>
    <!-- X-axis position servo -->
    <general name="act_x" joint="joint_x" gainprm="800 0 0"
             biasprm="0 -800 -40" biastype="affine"
             ctrlrange="-0.128 0.128" forcerange="-50 50"
             ctrllimited="true" forcelimited="true"/>

    <!-- Y-axis position servo -->
    <general name="act_y" joint="joint_y" gainprm="800 0 0"
             biasprm="0 -800 -40" biastype="affine"
             ctrlrange="-0.128 0.128" forcerange="-50 50"
             ctrllimited="true" forcelimited="true"/>

    <!-- Z-axis position servo (bed) -->
    <general name="act_z" joint="joint_z" gainprm="2000 0 0"
             biasprm="0 -2000 -120" biastype="affine"
             ctrlrange="-0.246 0.0" forcerange="-100 100"
             ctrllimited="true" forcelimited="true"/>
  </actuator>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--  SENSORS                                                            -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <sensor>
    <!-- Joint positions -->
    <jointpos name="sens_x"  joint="joint_x"/>
    <jointpos name="sens_y"  joint="joint_y"/>
    <jointpos name="sens_z"  joint="joint_z"/>
    <!-- Joint velocities -->
    <jointvel name="sens_vx" joint="joint_x"/>
    <jointvel name="sens_vy" joint="joint_y"/>
    <jointvel name="sens_vz" joint="joint_z"/>
    <!-- Nozzle tip 3-D position in world frame -->
    <framepos name="sens_nozzle_pos" objtype="site" objname="nozzle_tip_site"/>
  </sensor>

  <!-- ════════════════════════════════════════════════════════════════════ -->
  <!--  KEYFRAMES — useful starting poses                                  -->
  <!-- ════════════════════════════════════════════════════════════════════ -->
  <keyframe>
    <!-- Home: X=0, Y=0, Z at top (bed fully raised) -->
    <key name="home"       qpos="0 0 0"   ctrl="0 0 0"/>
    <!-- Bed lowered 50 mm for first layer at Z = 0.2 mm -->
    <key name="print_start" qpos="0 0 -0.05" ctrl="0 0 -0.05"/>
  </keyframe>

</mujoco>
